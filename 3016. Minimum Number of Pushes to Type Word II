class Solution:
    def minimumPushes(self, word: str) -> int:
        freq=[0]*26 
        for let in word:
            ind=ord(let)-ord('a')
            freq[ind]+=1 
        freq.sort(reverse=True)
        print(freq)
        res=0
        for ind,freq in enumerate(freq):
            if freq==0:
                break 
            res+=freq*(ind//8+1)
        return res
        
