import math
class Solution:
    def gcdSum(self, nums: list[int]) -> int:
        prefixgcd=[]
        max_pref=nums[0]
        for i in range(len(nums)):
            max_pref=max(nums[i],max_pref)
            k=math.gcd(nums[i],max_pref)
            prefixgcd.append(k)
        #print(prefixgcd)
        prefixgcd=sorted(prefixgcd)
        start=0 
        end=len(prefixgcd)-1
        res=0
        while(start<len(prefixgcd)//2):
            res+=(math.gcd(prefixgcd[start],prefixgcd[end]))
            start+=1
            end-=1 
        return res
        
